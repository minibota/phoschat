{
  "app-id": "io.phoschat.desktop",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "phoschat",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.kde.kwalletd6",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "cleanup": ["/include", "/lib/cmake", "/lib/pkgconfig", "*.a"],
  "modules": [
    {
      "name": "gperf",
      "cleanup": ["*"],
      "sources": [
        {
          "type": "archive",
          "url": "https://ftp.gnu.org/pub/gnu/gperf/gperf-3.1.tar.gz",
          "sha256": "588546b945bba4b70b6a3a616e80b4ab466e3f33024a352fc2198112cdbb3ae2"
        }
      ]
    },
    {
      "name": "qtkeychain",
      "buildsystem": "cmake-ninja",
      "config-opts": ["-DCMAKE_BUILD_TYPE=Release", "-DBUILD_SHARED_LIBS=OFF", "-DBUILD_TRANSLATIONS=OFF"],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/frankosterfeld/qtkeychain.git",
          "tag": "0.17.0",
          "commit": "875f77d9f61bd97fd84cca47ce3bc71186dfbd09"
        }
      ],
      "post-install": ["install -Dm644 COPYING /app/share/doc/phoschat/QtKeychain.txt"]
    },
    {
      "name": "tdlib",
      "buildsystem": "simple",
      "build-commands": [
        "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DTD_ENABLE_LTO=OFF -DTD_INSTALL_STATIC_LIBRARIES=OFF",
        "cmake --build build --target tdjson --parallel 2",
        "install -Dm755 \"$(readlink -f build/libtdjson.so)\" /app/lib/phoschat/libtdjson.so",
        "install -Dm644 LICENSE_1_0.txt /app/share/doc/phoschat/TDLib.txt"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/tdlib/td.git",
          "commit": "c8828d50f5eac2fc7089ce1089d7ce9095c61b5e"
        }
      ]
    },
    {
      "name": "phoschat",
      "buildsystem": "cmake-ninja",
      "config-opts": ["-DCMAKE_BUILD_TYPE=Release", "-DBUILD_TESTING=OFF"],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [".git", ".cache", ".codex", ".phoschat-toolchain", ".flatpak-builder", "build", "build-flatpak", "dist", "repo", "artifacts"]
        }
      ]
    }
  ]
}

set(PHOSCHAT_SLACK_CLIENT_ID "$ENV{PHOSCHAT_SLACK_CLIENT_ID}" CACHE STRING
    "Optional public Slack application Client ID for browser sign-in")
set(PHOSCHAT_SLACK_OAUTH_ORIGIN "$ENV{PHOSCHAT_SLACK_OAUTH_ORIGIN}" CACHE STRING
    "Optional HTTPS origin for the shared Slack OAuth callback and refresh service")

function(phoschat_configure_slack_application output_directory)
    if(NOT PHOSCHAT_SLACK_CLIENT_ID STREQUAL "")
        if(NOT PHOSCHAT_SLACK_CLIENT_ID MATCHES "^([0-9]+)[.]([0-9]+)$")
            message(FATAL_ERROR "PHOSCHAT_SLACK_CLIENT_ID must be a public numeric Slack Client ID.")
        endif()
        string(LENGTH "${CMAKE_MATCH_1}" first_length)
        string(LENGTH "${CMAKE_MATCH_2}" second_length)
        if(first_length GREATER 32 OR second_length GREATER 32)
            message(FATAL_ERROR "PHOSCHAT_SLACK_CLIENT_ID must be a public numeric Slack Client ID.")
        endif()
    endif()
    if(NOT PHOSCHAT_SLACK_OAUTH_ORIGIN STREQUAL "")
        if(PHOSCHAT_SLACK_CLIENT_ID STREQUAL "")
            message(FATAL_ERROR "PHOSCHAT_SLACK_OAUTH_ORIGIN requires PHOSCHAT_SLACK_CLIENT_ID.")
        endif()
        if(NOT PHOSCHAT_SLACK_OAUTH_ORIGIN MATCHES "^https://([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?[.])+[A-Za-z]([A-Za-z0-9-]*[A-Za-z0-9])?$")
            message(FATAL_ERROR "PHOSCHAT_SLACK_OAUTH_ORIGIN must be a bare HTTPS origin with a DNS hostname.")
        endif()
        string(REGEX REPLACE "^https://" "" hostname "${PHOSCHAT_SLACK_OAUTH_ORIGIN}")
        string(LENGTH "${hostname}" hostname_length)
        string(REPLACE "." ";" labels "${hostname}")
        foreach(label IN LISTS labels)
            string(LENGTH "${label}" label_length)
            if(label_length GREATER 63 OR hostname_length GREATER 253)
                message(FATAL_ERROR "PHOSCHAT_SLACK_OAUTH_ORIGIN contains an invalid DNS hostname.")
            endif()
        endforeach()
    endif()
    file(MAKE_DIRECTORY "${output_directory}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/slack_build_config.h.in"
        "${output_directory}/slack_build_config.h" @ONLY)
endfunction()
